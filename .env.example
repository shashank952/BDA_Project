# Copy to .env and adjust for your machine. Nothing here is a secret;
# these are local paths and endpoints for a single-node academic deployment.

# Hadoop installation (must contain bin/winutils.exe on Windows)
AIRLINE_HADOOP_HOME=D:/hadoop/hadoop-3.2.4

# JDK used by Hadoop/Hive (Hadoop 3.2.4 does not run on JDK 17+)
AIRLINE_JAVA_HOME=D:/java/jdk8u504-b01

# HDFS endpoint from config/settings.yaml (hdfs://localhost:9000)
AIRLINE_HDFS_URI=hdfs://localhost:9000

# MapReduce execution: local = LocalJobRunner, yarn = cluster scheduler
AIRLINE_MR_FRAMEWORK=local

# Flask API
AIRLINE_API_HOST=127.0.0.1
AIRLINE_API_PORT=5050

# Dashboard -> API base URL
AIRLINE_API_URL=http://127.0.0.1:5050
